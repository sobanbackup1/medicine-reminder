# ------------------------------------------------------------------ #
#  Medication Reminder - Environment Configuration                    #
#  Copy this file to .env and edit the values.                        #
# ------------------------------------------------------------------ #

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=medication
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=medication_reminder

# --- App Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
# The public URL patients reach this site at (used in Bark notification links)
WEBSITE_URL=https://med.sobanfarooq.org

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- Default Settings (seeded into DB, editable later from the UI) ---
MEDICINE_NAME=Medication
MEDICATION_TIME=22:00
REMINDER_START_TIME=22:30
REMINDER_INTERVAL=2
EMERGENCY_TIME=23:55

# --- Bark API Keys ---
PATIENT_BARK_KEY=
EMERGENCY_BARK_KEY=

# --- Notification Content ---
NOTIFICATION_TITLE=Medication Reminder
NOTIFICATION_MESSAGE=It is time to take your medication. Please confirm.

# --- Timezone ---
TIMEZONE=Asia/Tokyo

# --- Backups ---
BACKUP_DIR=backups
